# ── AI Provider (pick one) ──────────────────────────────
# Options: groq | gemini | ollama | anthropic
AI_PROVIDER=groq

# GROQ — FREE, no credit card needed → https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# GEMINI — FREE tier → https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# ANTHROPIC — paid → https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# OLLAMA — 100% offline/free → https://ollama.com (run locally)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Weather (optional, free) ────────────────────────────
# https://openweathermap.org/api  (free signup)
WEATHER_API_KEY=your_openweathermap_key_here
WEATHER_CITY=New York
